    "recipe": {
      "id": "shopee",
      "name": "Shopee — conversão GraphQL com sessão local",
      "loginUrl": "https://affiliate.shopee.com.br/offer/custom_link",
      "allowedOrigins": [
        "https://shopee.com.br",
        "https://www.shopee.com.br",
        "https://affiliate.shopee.com.br"
      ],
      "affiliateOrigins": [
        "https://s.shopee.com.br",
        "https://shopee.com.br"
      ],
      "batchSize": 1,
      "intervalMs": 5000,
      "steps": [
        {
          "type": "extract",
          "name": "csrf",
          "source": "requestHeader",
          "key": "csrf-token",
          "sourceUrl": "https://affiliate.shopee.com.br/api/v3/gql?q=batchCustomLink"
        },
        {
          "type": "request",
          "url": "https://affiliate.shopee.com.br/api/v3/gql?q=batchCustomLink",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json; charset=UTF-8",
            "affiliate-program-type": "1",
            "csrf-token": "{{csrf}}"
          },
          "bodyEncoding": "json",
          "body": {
            "operationName": "batchGetCustomLink",
            "query": "query batchGetCustomLink($linkParams: [CustomLinkParam!], $sourceCaller: SourceCaller) { batchCustomLink(linkParams: $linkParams, sourceCaller: $sourceCaller) { shortLink longLink failCode } }",
            "variables": {
              "linkParams": [
                {
                  "originalLink": "{{originalUrl}}",
                  "advancedLinkParams": {
                    "subId1": "OEspertinho"
                  }
                }
              ],
              "sourceCaller": "CUSTOM_LINK_CALLER"
            }
          },
          "responsePath": "data.batchCustomLink.0.shortLink",
          "responseChecks": [
            {
              "path": "data.batchCustomLink.0.failCode",
              "equals": 0
            }
          ]
        }
      ]
    }
  },
