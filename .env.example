NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:4200
POSTGRES_USER=espertinho
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=espertinho
POSTGRES_PORT=5432
DATABASE_URL=postgresql://espertinho:replace-with-a-random-password@127.0.0.1:5432/espertinho
# 32 random bytes, base64. npm run setup:env generates local secrets.
ENCRYPTION_KEY=
# URL publica HTTPS do callback. Local: tunel para o backend na porta 3000.
# Exemplo: https://seu-tunel.example/api/admin/mercadolivre/callback
MELI_REDIRECT_URI=
# Deve corresponder a opcao PKCE necessario do DevCenter.
MELI_OAUTH_PKCE=false
GOOGLE_CLIENT_ID=
WORKER_INTERVAL_SECONDS=60
RUN_WORKER=true



# Extrator legado, usado somente pelo job de atualizacao de precos.
SCRAPER_SERVICE_URL=http://127.0.0.1:3010
EXTRACTION_SERVICE_TOKEN=

# Novo extrator manual: testes de seletores e previas de cadastro de links.
# npm run setup:manual-extractor configura a origem local e copia apenas seu segredo.
# Em producao, configure uma origem privada (ex.: http://espertinho-manual-extractor:3011).
MANUAL_EXTRACTOR_URL=
MANUAL_EXTRACTION_SERVICE_TOKEN=

# Extensão: autenticação real e fila/configurações demonstrativas apenas fora de produção.
EXTENSION_MOCK_ENABLED=true
EXTENSION_BACKEND_URL=http://localhost:3000
