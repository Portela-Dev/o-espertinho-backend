{
  "name": "espertinho-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:seed:admin": "tsx src/admin-seed-cli.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:config": "docker compose --env-file .env.example config --quiet",
    "test": "npm run build && node --test test/*.test.mjs",
    "worker": "tsx src/worker.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "test:coverage": "npm run build && c8 node --test --test-concurrency=2 test/*.test.mjs",
    "test:catalog:postgres": "npm run build && node scripts/test-catalog-postgres.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "^0.5.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "12.0.0",
    "esbuild": "0.25.12",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "packageManager": "npm@11.19.0"
}
