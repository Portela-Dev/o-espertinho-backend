POSTGRES_USER=espertinho
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=espertinho
# Use the same password above. Encode special characters in the URL.
MIGRATION_DATABASE_URL=postgresql://espertinho:replace-with-a-random-password@postgres:5432/espertinho
# Conta criada pelo provisionamento; use outra senha aleatoria de ao menos 24 caracteres.
DATABASE_URL=postgresql://espertinho_app:replace-with-another-random-password@postgres:5432/espertinho
APP_ORIGIN=https://seu-dominio.example
# Use a origem publica do site para compartilhar a sessao de login via /api.
EXTENSION_BACKEND_URL=https://seu-dominio.example
GOOGLE_CLIENT_ID=
RUN_WORKER=true
WORKER_INTERVAL_SECONDS=60
